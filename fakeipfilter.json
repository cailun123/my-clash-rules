        ".mirror.aliyuncs.com",
        // 新增：edu 校园网
        ".edu.cn"
      ]
    },
    {
      "domain_regex": [
        // NTP 服务器
        "^time\..*\\.com$",
        "^time\\.*\\.gov$",
        "^time\..*\\.edu\\.cn$",
        "^time[1-7]\\..*\\.com$",
        "^ntp[0-7]?\..*\\.com$",
        "^[^.]+\\.time\\.edu\\.cn$",
        "^[^.]+\\.ntp\\.org\\.cn$",
        // localhost前缀（微信、Q 等本地回调）
        "^localhost\\.[^.]+\\.qq\\.com$",
        // Nintendo
        "^[^.]+\.n\\.n\\.srv\\.nintendo\\.net$",
        // Xbox / Microsoft
        "^xbox\\.[^.]+\\.microsoft\.com$",
        "^[^.]+\\.[^.]+\\.xboxlive\\.com$",
        "^xbox\\.[^.]+\\.microsoft\\.com$",
        // STUN 服务器（WebRTC 直连，统一用条正则覆盖所有层级）
        "^(.+\\.)?stun\\..+$"
      ]
    }
  ]
