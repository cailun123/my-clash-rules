{
  "version": 3,
  "rules": [
    {
      "domain": [
        "localhost",
        "captive.apple.com",
        "connectivitycheck.gstatic.com",
        "dns.msftncsi.com",
        "www.msftncsi.com",
        "ipv6.msftconnecttest.com",
        "local.adguard.org"
      ]
    },
    {
      "domain_suffix": [
        ".direct",
        ".pool.ntp.org",
        ".msftconnectest.com",
        ".msftncsi.com",
        ".3gppnetwork.org",
        ".pub.3gppnetwork.org"
      ]
    },
    {
      "domain_regex": [
        "^time[1-7]?\\.[^.]+\.com$",
        "^time[1-7]?\\.[^.]+\\.gov$",
        "^time[1-7]?\\.[^.]+\\.edu\\.cn$",
        "^ntp[0-7]?\\.[^.]+\\.com$",
        "^[^.]+\.time\\.edu\\.cn$",
        "^[^.]+\\.ntp\\.org\\.cn$",
        "^localhost\\.[^.]+\\.qq\\.com$",
        "^(.+\\.)?stun\\..+$"
      ]
    }
  ]
}
